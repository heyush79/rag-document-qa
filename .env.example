# Copy to .env and adjust. Every setting is optional; the values shown are the defaults.
# All variables use the RAG_ prefix.

# --- Storage ---------------------------------------------------------------
RAG_SQLITE_PATH=data/rag.db
RAG_CHROMA_PATH=data/chroma
# Use a new collection name whenever you change the embedding backend or model.
RAG_CHROMA_COLLECTION=documents

# --- Embeddings ------------------------------------------------------------
# sentence-transformers runs locally and needs the "local" extra:
#   pip install -e ".[local,dev]"
# openai-compatible calls any POST /v1/embeddings server, so the image can skip torch.
# hashing needs no download or server; use it for smoke runs.
RAG_EMBEDDING_BACKEND=sentence-transformers
# The model name for the sentence-transformers and openai-compatible backends.
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Only used by the hashing backend.
RAG_EMBEDDING_DIMENSION=384
# Only used by the openai-compatible backend. Google AI Studio example:
# RAG_EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# RAG_EMBEDDING_API_KEY=your-ai-studio-key
# RAG_EMBEDDING_MODEL=gemini-embedding-001
# Texts per request to the embedding API.
RAG_EMBEDDING_BATCH_SIZE=64

# --- Chunking and retrieval ------------------------------------------------
RAG_CHUNK_SIZE_WORDS=180
RAG_CHUNK_OVERLAP_WORDS=30
RAG_DEFAULT_TOP_K=4
# Chunks scoring below this are never shown to the answer provider or returned as sources.
RAG_MIN_RELEVANCE_SCORE=0.15
RAG_MAX_UPLOAD_MB=10

# --- Authentication --------------------------------------------------------
# Off by default: every route is open and the app warns at startup. Turn it on before
# exposing the API. Then every route except /, /health and the docs needs
# "Authorization: Bearer <key>". Keys are created with the admin key, which also works
# as a regular key.
RAG_AUTH_ENABLED=false
# RAG_ADMIN_API_KEY=change-me-to-a-long-random-string

# --- Answer generation -----------------------------------------------------
# extractive works offline with no key. openai-compatible calls any
# /v1/chat/completions server and needs the base URL and model below.
RAG_ANSWER_PROVIDER=extractive
# RAG_LLM_BASE_URL=http://localhost:11434/v1
# RAG_LLM_API_KEY=local-key
# RAG_LLM_MODEL=llama3.2:3b
# Google AI Studio (free tier):
# RAG_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# RAG_LLM_API_KEY=your-ai-studio-key
# RAG_LLM_MODEL=gemini-2.5-flash
# Providers tried in order when the one above fails (an error, a timeout or a rate limit),
# as a JSON list. A streamed answer only falls back before any text has been sent.
# RAG_LLM_FALLBACKS='[{"base_url": "http://localhost:11434/v1", "model": "llama3.2:3b", "api_key": "local-key"}]'
# Timeout for each request to an LLM or embedding API.
RAG_LLM_TIMEOUT_SECONDS=60
# The model's context window in tokens. Retrieved chunks are trimmed to fit
# what's left after the reserved tokens, less a 10% margin.
RAG_LLM_CONTEXT_WINDOW=8192
RAG_LLM_RESERVED_TOKENS=2000

# --- Conversations ---------------------------------------------------------
# A query with a conversation_id gets the conversation's recent turns as context: at most
# this many turns (a question and its answer), and only as many of the latest ones as fit
# in the token limit. 0 turns disables conversation context.
RAG_HISTORY_MAX_TURNS=6
RAG_HISTORY_TOKEN_LIMIT=1000

# --- Guardrails ------------------------------------------------------------
# off: no checks. flag (default): report emails, phone numbers, card numbers, API keys and
# prompt-injection phrases found in questions, answers and retrieved chunks, as "warnings"
# on query responses, and log them. redact: also replace the personal data and keys with
# placeholders such as [REDACTED_EMAIL], in the question before retrieval and in the answer
# before it is returned or saved. Retrieved chunks are only ever flagged, never changed.
RAG_GUARDRAILS_MODE=flag
