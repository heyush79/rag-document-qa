# Copy to .env and adjust. Every setting is optional; the values shown are the defaults.
# All variables use the RAG_ prefix.

# --- Storage ---------------------------------------------------------------
RAG_SQLITE_PATH=data/rag.db
RAG_CHROMA_PATH=data/chroma
# Use a new collection name whenever you change the embedding backend or model.
RAG_CHROMA_COLLECTION=documents

# --- Embeddings ------------------------------------------------------------
# sentence-transformers downloads the model on first use.
# hashing needs no download; use it for smoke runs.
RAG_EMBEDDING_BACKEND=sentence-transformers
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Only used by the hashing backend.
RAG_EMBEDDING_DIMENSION=384

# --- Chunking and retrieval ------------------------------------------------
RAG_CHUNK_SIZE_WORDS=180
RAG_CHUNK_OVERLAP_WORDS=30
RAG_DEFAULT_TOP_K=4
RAG_MIN_RELEVANCE_SCORE=0.15
RAG_MAX_UPLOAD_MB=10

# --- Answer generation -----------------------------------------------------
# extractive works offline with no key. openai-compatible calls any
# /v1/chat/completions server and needs the base URL and model below.
RAG_ANSWER_PROVIDER=extractive
# RAG_LLM_BASE_URL=http://localhost:11434/v1
# RAG_LLM_API_KEY=local-key
# RAG_LLM_MODEL=llama3.2:3b
RAG_LLM_TIMEOUT_SECONDS=60
