{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Pytest",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "pytest",
        "-q"
      ],
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Run FastAPI",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/python",
      "args": [
        "-m",
        "uvicorn",
        "app.main:create_app",
        "--factory",
        "--reload"
      ],
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
